  DEP_FILE = StandAlone/CMakeFiles/glslang-standalone.dir/StandAlone.cpp.o.d
  FLAGS = -O2 -g -DNDEBUG -std=c++17 -Wall -Wmaybe-uninitialized -Wuninitialized -Wunused -Wunused-local-typedefs -Wimplicit-fallthrough -Wunused-parameter -Wunused-value -Wunused-variable -Wunused-but-set-parameter -Wunused-but-set-variable -Wno-format-zero-length -fno-rtti -fno-exceptions -Werror=deprecated-copy -Wconversion
  INCLUDES = -I/home/cat/gsb/uid3857/StandAlone/../External -I/home/cat/gsb/uid3857/glslang/.. -I/home/cat/gsb/uid3857/build-property/include
