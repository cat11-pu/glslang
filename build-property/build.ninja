  OBJECT_DIR = StandAlone/CMakeFiles/glslang-standalone.dir
  POST_BUILD = cd /home/cat/gsb/uid3857/build-property/StandAlone && /usr/bin/cmake -E create_symlink glslang glslangValidator
  PRE_LINK = :
